# ⚠️ NOTE: GitHub Pages does NOT serve custom headers from _headers files.
# CSP / Referrer-Policy / Permissions-Policy are shipped via <meta> tags in index.html (works on GH Pages).
# This file is kept for FUTURE hosting on Cloudflare Pages / Netlify, which DO honor _headers.
# If migrating, remove the meta tags from index.html to avoid double application.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://www.hktvmall.com; connect-src 'self'; font-src 'self' data: https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
